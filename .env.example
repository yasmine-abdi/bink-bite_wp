# ==============================================================================
# FASTBITE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# NEVER commit your actual .env file with production credentials to version control.
# ==============================================================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fastbite_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/bink%20bite_fast%20food
APP_NAME="FastBite Fast Food"

# Security & Session
SESSION_LIFETIME=604800
CSRF_SECRET=your_random_csrf_secret_here

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/bink%20bite_fast%20food/google-auth.php

# SMTP / Email Configuration (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=support@fastbite.com
MAIL_FROM_NAME="FastBite Fast Food"

# Payment Gateway Configuration (Optional)
PAYMENT_STRIPE_KEY=pk_test_placeholder
PAYMENT_STRIPE_SECRET=sk_test_placeholder
PAYMENT_WEBHOOK_SECRET=whsec_placeholder
